# Optional developer overrides. The packaged app does not require an API key.
# Values must be absolute paths and must never point automated tests at real data.

# Parent directory used by `npm run dev` for its default .library.
# VIDEO_CONTENT_LIBRARY_ROOT=/Users/your-name/Documents/VideoStudio

# Directory used by dedicated Douyin/Xiaohongshu login browsers.
# VIDEO_CONTENT_AUTH_ROOT=/Users/your-name/Library/Application Support/视频内容创作中台/auth-browser

# Playwright test server port.
# PLAYWRIGHT_PORT=4174
